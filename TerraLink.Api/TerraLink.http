###############################################################################
# HEALTH                                                                      #
###############################################################################

### Root / health check
GET {{baseUrl}}


###############################################################################
# AUTH                                                                                 
###############################################################################

### Login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
    "identifier":"TL-8842",
    "password": "Admin@terralink26"
}

# {
#     "identifier": "TC-F15F",
#     "password": "Terralink@2026"
# }

### Refresh token
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
    "refreshToken": "{{refreshToken}}"
}

### Logout
POST {{baseUrl}}/api/auth/logout
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "refreshToken": "{{refreshToken}}"
}

### Forgot password
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: application/json

{
    "identifier": "loan.officer@terralink.com"
}

### Reset password
POST {{baseUrl}}/api/auth/reset-password
Content-Type: application/json

{
    "token": "TOKEN_FROM_TERMINAL",
    "newPassword": "NewSecurePassword123!"
}

### Verify MFA
POST {{baseUrl}}/api/auth/mfa/verify
Content-Type: application/json

{
    "mfaToken": "{{mfaTokenFromLogin}}",
    "code": "515588"
}


###############################################################################
# USERS  (staff: admins, loan officers, etc.)
###############################################################################

### GET logged in user/client profile
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{accessToken}}

# ### List all users
# GET {{baseUrl}}/api/users

### Get user by id
GET {{baseUrl}}/api/users/2
Authorization: Bearer {{accessToken}}

### patch logged in user/client
PATCH  {{baseUrl}}/api/users/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "email": "loan.officer@terralink.org",
    "username": "0798765431",
    "mfaEnabled": true
}

### Create user
POST {{baseUrl}}/users
Content-Type: application/json

{
    "FullName": "Darwin",
    "Email": "Darwin@example.com",
    "Phone": "123-456-7890",
    "Password": "password123",
    "Role": "Client",
    "Status": "Active"
}

### Update user
PUT {{baseUrl}}/users/2
Content-Type: application/json

{
    "EmployeeId": "TL-002",
    "FullName": "Alice Smith",
    "Email": "alice.smith@example.com",
    "Phone": "987-654-3210",
    "Password": "newpassword456",
    "Role": "Admin",
    "Status": "Active"
}

### Delete user
DELETE {{baseUrl}}/users/2


###############################################################################
# CLIENTS
###############################################################################

###
//GET all clients pagination
GET {{baseUrl}}/api/clients?page=1&pageSize=20
Authorization: Bearer {{accessToken}}

### Get client by id
GET {{baseUrl}}/api/clients/8
Authorization: Bearer {{accessToken}}

###
//PATCH client
PATCH {{baseUrl}}/api/clients/8
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ 
  "phone": "0712408290", 
  "nationalId":"42572240",
  "fullName": "John Maina",
  "address": "Plot 45B, Industrial Area, East Cluster" 
} 
### Verify clients
//
POST {{baseUrl}}/api/clients/9/verify
Authorization: Bearer {{accessToken}}

### Verify reject
//
POST {{baseUrl}}/api/clients/8/reject
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "reason": "ID photo illegible — please re-upload."
}

### Officer registers and auto-verifies a client
POST {{baseUrl}}/api/clients/register
Authorization: Bearer {{loanOfficerToken}}
Content-Type: multipart/form-data; boundary={{boundary}}

--{{boundary}}
Content-Disposition: form-data; name="fullName"

John Mwangi
--{{boundary}}
Content-Disposition: form-data; name="nationalId"

87654321
--{{boundary}}
Content-Disposition: form-data; name="phone"

0798765432
--{{boundary}}
Content-Disposition: form-data; name="dateOfBirth"

1990-02-15
--{{boundary}}
Content-Disposition: form-data; name="gender"

MALE
--{{boundary}}
Content-Disposition: form-data; name="address"

Karen, Nairobi
--{{boundary}}
Content-Disposition: form-data; name="nationalIdFront"; filename="id-front.jpg"
Content-Type: image/jpeg

< ./test-files/id-front.jpg
--{{boundary}}
Content-Disposition: form-data; name="nationalIdBack"; filename="id-back.jpg"
Content-Type: image/jpeg

< ./test-files/id-back.jpg
--{{boundary}}
Content-Disposition: form-data; name="passportPhoto"; filename="passport-photo.jpg"
Content-Type: image/jpeg

< ./test-files/passport-photo.jpg
--{{boundary}}--



